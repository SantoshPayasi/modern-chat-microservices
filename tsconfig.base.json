{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Node",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "sourceMap": true,
        "outDir": "dist",
        "types": [
            "node"
        ]
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}